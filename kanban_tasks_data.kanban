		{
			"uuid": "dfe7a6b4-2f75-44e7-adca-9e58fa1409d6",
			"title": "Add Target Destination system",
			"description": "A player can set a target location and the \"target fuel\" amount coincides with that location relative to where the player currently is located.\n\nIn-game, if the player is below the minimum amount of fuel needed, the bottom fuel number will be white and the top number will be red. If the player has a target destination set and is above the minimum amount of fuel needed, the bottom number will turn blue while the top number either stays red or change to something like yellow. Whenever the top number is above the given threshold number below, it will be white.",
			"category": "1cc9593e-303e-45bd-9fde-a46b9f56da9e",
			"steps": []
		}
