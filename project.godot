; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Roguemin"
config/description="Pikmin re-imagined as a traditional roguelike."
config/version="ALPHA 0.1"
run/main_scene="res://prefabs/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Globals="*res://scripts/globals.gd"
Util="*res://scripts/lib/util.gd"
GameState="*res://scripts/game_state.gd"
InputManager="*res://scripts/input_manager.gd"
TurnManager="*res://scripts/turn_manager.gd"
Tag="*res://scripts/lib/tag.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/int_as_enum_without_cast=0

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/editor_button/plugin.cfg")

[file_customization]

folder_colors={
"res://_notes/": "gray",
"res://assets/": "green",
"res://prefabs/": "purple",
"res://scripts/": "blue"
}

[gui]

theme/custom_font="res://assets/pixelchunk.ttf"
theme/default_font_antialiasing=0

